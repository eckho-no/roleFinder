# roleFinder web/ — environment contract
#
# Cloudflare bindings (D1, KV, Vectorize, Queue, Workers AI, Assets, the
# WORKER_SELF_REFERENCE service) are NOT env vars — they're configured in
# wrangler.jsonc and typed in cloudflare-env.d.ts (regenerate with
# `npm run cf-typegen` after changing wrangler.jsonc). Access them via
# `env.DB`, `env.KV`, etc. in a route handler, not `process.env`.
#
# No app secrets are required yet as of M1 (deploy spine). Real secrets are
# never committed and never go in a plain .env file — they're set with
# `wrangler secret put <NAME>` for the deployed Worker, and in a gitignored
# .dev.vars file for local dev. This file documents what will exist:
#
# M3 (auth):
#   AUTH_PASSWORD=          # constant-time-compared login password
#   DEMO_PASSWORD=           # read-only demo-mode password
#   SESSION_SIGNING_SECRET=  # HMAC key for the signed session cookie
#
# M5 (agent core):
#   ANTHROPIC_API_KEY=       # direct fetch to the Messages API, not the Node SDK —
#                            # only src/lib/agents/dispatcher.ts is allowed to read
#                            # this; every other file fails lint if it fetches
#                            # api.anthropic.com directly.
#
# M5's hop-limit and daily-budget-cap config (AGENT_MAX_HOPS,
# AGENT_DAILY_BUDGET_USD) are NOT secrets — they're plain `vars` in
# wrangler.jsonc, not set via `wrangler secret put` or `.dev.vars`.
#
# Local dev only (optional, in a gitignored .dev.vars, not this file):
#   NEXTJS_ENV=development
